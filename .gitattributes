# Normalize text to LF (prevent CRLF creeping in on a Windows drive).
# Even when checked out on a Windows mount such as /mnt/d, keep LF in the repo and working tree.
* text=auto eol=lf

# Shell scripts and makefile require LF (CRLF breaks them at runtime).
*.sh    text eol=lf
makefile text eol=lf
Makefile text eol=lf

# The dashboard bundle is generated (scripts/build_ui.mjs from ui/), committed because the wheel
# ships it, and minified — so a one-line UI change rewrites the whole file. Marking it generated
# collapses it in review, where the diff to read is the one under ui/.
src/rein/ui_assets/app.js linguist-generated=true

# Do not convert binaries.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.lock  text eol=lf
