# The implementer sandbox: where a task's code is written.
#
# Built with `rein oci build --profile implementer`.
#
# Unlike the reviewer this one gets a WRITABLE worktree — it has to, it is writing code — plus
# a bind mount of the control socket. That socket is the only way a leaf worktree may record a
# decision or a knowledge gap: writing to a leaf-local .rein/ is how a judgement recorded
# during a parallel build disappeared when the worktree was removed (plan §11.1).
#
# The capability token the leaf receives is scoped to `decision.declare`, `knowledge_gap.create`,
# `task.status`, and `event.append`. It can never carry `gate.approve`, `expert.confirm`,
# `human.review.complete`, `review.machine.replace`, or `state.replace`:
# an agent that can approve its own work has not been reviewed by anyone.

# Pinned by digest, not by tag. `python:3.13-slim-bookworm` is a moving target: two builds a month
# apart produced different images, so the digest pinned into config.yaml recorded whatever happened
# to be current rather than reproducing anything. This is the multi-arch index digest, so arm64 and
# amd64 hosts still each get their own layer set.
#
# Still not bit-reproducible: the apt packages below resolve against the live Debian archive, so a
# rebuild months later can pick up newer point releases. What the pin buys is that the interpreter,
# its libraries and the base filesystem cannot move underneath a signed review — and `rein oci
# verify` catches the rest by comparing the built digest against the one the profile names.
FROM docker.io/library/python:3.13-slim-bookworm@sha256:9d7f287598e1a5a978c015ee176d8216435aaf335ed69ac3c38dd1bbb10e8d64

RUN groupadd --gid 1000 implementer \
 && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash implementer

RUN apt-get update \
 && apt-get install --no-install-recommends -y git make ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /usr/local/bin/uv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/implementer \
    GIT_CONFIG_SYSTEM=/dev/null

USER 1000:1000
WORKDIR /worktree
ENTRYPOINT []
CMD ["bash", "-lc", "echo 'rein implementer sandbox'"]
